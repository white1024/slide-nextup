    {
      "id": "s4",
      "layout": "cards",
      "slots": {
        "title": {
          "type": "text",
          "value": "All three design principles are *deliberate*"
        },
        "kicker": {
          "type": "text",
          "value": "01 - Skeleton"
        },
        "meta": {
          "type": "text",
          "value": "Progress meeting"
        },
        "page": {
          "type": "text",
          "value": "04 / 08"
        },
        "subtitle": {
          "type": "text",
          "value": "Never merged, shared contract, scoring apart: each maps to one block of the system map."
        },
        "card-1": {
          "type": "metric",
          "value": "01",
          "label": "Two paths, never merged",
          "delta": "The browser path loads and renders and is the primary source; the crawler path only cross-checks"
        },
        "card-2": {
          "type": "metric",
          "value": "02",
          "label": "One shared report directory",
          "delta": "Per-page state is written atomically; a run interrupted at any moment resumes where it stopped"
        },
        "card-3": {
          "type": "metric",
          "value": "03",
          "label": "Scoring is a second pass",
          "delta": "Rescoring is free, rechecking takes a whole night; the verdict policy can change without rerunning the numbers"
        }
      },
