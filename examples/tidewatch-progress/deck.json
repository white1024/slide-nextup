    {
      "id": "s5",
      "layout": "cards-2",
      "slots": {
        "title": {
          "type": "text",
          "value": "Delivered so far: *one contract*, one bundle"
        },
        "kicker": {
          "type": "text",
          "value": "02 - Deliverables"
        },
        "meta": {
          "type": "text",
          "value": "Progress meeting"
        },
        "page": {
          "type": "text",
          "value": "05 / 08"
        },
        "subtitle": {
          "type": "text",
          "value": "Every platform shares the Result Schema v1 contract; the bundle installs unattended on a clean machine."
        },
        "card-1": {
          "type": "metric",
          "value": "v1.0.0",
          "label": "Result Schema",
          "delta": "The result.json contract every platform shares, with three role documents: operator, viewer, new-platform",
          "details": {
            "type": "list",
            "items": [
              "operator: the person who runs the check. Prepares the site list, goes through the six steps, remembers to export",
              "viewer: the person who reads the results. Reads only result.json, never touches the report directory",
              "new-platform: the person connecting a new platform. Produces result.json to Result Schema v1; passing the smoke test means it is connected"
            ]
          }
        },
        "card-2": {
          "type": "metric",
          "value": "0.1.0",
          "label": "Bundle",
          "delta": "Executable, configuration, docs and browser engine; unzip on a clean machine and it installs unattended"
        }
      },
