{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://slide-workflow.local/schemas/layout.schema.json",
  "title": "Layout",
  "description": "layouts/<id>/layout.json: a layout describes structure only. slots are the content slots the agent fills, elements are what the editor can manipulate; both sets of ids must match data-slot / data-el in layout.html.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "content_relations",
    "scene_roles",
    "density",
    "slots",
    "elements",
    "sample"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence on which content relation this layout suits and what would be lost by using a plain grid instead"
    },
    "content_relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["statement", "comparison", "sequence", "hierarchy", "evidence", "list", "closing"]
      }
    },
    "scene_roles": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["hero", "map", "evidence", "relationship", "pause", "close"] }
    },
    "density": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_chars", "max_elements"],
      "properties": {
        "max_chars": { "type": "integer", "minimum": 1 },
        "max_elements": { "type": "integer", "minimum": 1 }
      }
    },
    "slots": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "required"],
        "properties": {
          "type": {
            "description": "Accepted slot types, one or more (a card may accept both text and metric)",
            "oneOf": [
              { "enum": ["text", "list", "image", "metric", "chart", "table", "code", "icon", "tabs"] },
              {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["text", "list", "image", "metric", "chart", "table", "code", "icon", "tabs"] }
              }
            ]
          },
          "required": { "type": "boolean" },
          "hint": { "type": "string" },
          "fit": {
            "enum": ["cover", "contain"],
            "description": "image slots only: how the picture fills its box. cover (the default) fills the box and crops what does not fit, for photos; contain shows the whole picture and leaves bands, for diagrams and charts. QA warns when a cover picture's ratio is far from its box's."
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
          "kind": { "enum": ["text", "image", "shape"] }
        }
      }
    },
    "sample": {
      "type": "object",
      "description": "Sample content for previews and tests; keys must be slots",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
      "additionalProperties": {
        "$ref": "https://slide-workflow.local/schemas/deck.schema.json#/definitions/slot"
      }
    }
  }
}
