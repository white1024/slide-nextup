{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://slide-workflow.local/schemas/theme.schema.json",
  "title": "Theme",
  "description": "themes/<id>/theme.json：主題只描述視覺語言。色彩以「用途」命名，字級與位置不屬於主題。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "colors",
    "typography",
    "spacing",
    "decoration"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "theme.json 的格式版本；這個引擎認得 1（pnpm theme:check 會對）"
    },
    "engine": {
      "type": "string",
      "minLength": 1,
      "description": "需要的引擎版本範圍（semver：>=0.1.0、^0.1.0、0.1.x、>=1.0.0 <2.0.0），對 package.json 的 version；沒寫就不限"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "colors": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/color"
      },
      "required": [
        "paper",
        "ink",
        "muted",
        "accent",
        "surface",
        "line"
      ],
      "properties": {
        "paper": {
          "$ref": "#/definitions/color"
        },
        "ink": {
          "$ref": "#/definitions/color"
        },
        "muted": {
          "$ref": "#/definitions/color"
        },
        "accent": {
          "$ref": "#/definitions/color"
        },
        "surface": {
          "$ref": "#/definitions/color"
        },
        "line": {
          "$ref": "#/definitions/color"
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display",
        "body"
      ],
      "properties": {
        "display": {
          "$ref": "#/definitions/face"
        },
        "body": {
          "$ref": "#/definitions/face"
        }
      }
    },
    "spacing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "radius"
      ],
      "properties": {
        "radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      }
    },
    "decoration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vocabulary",
        "avoid"
      ],
      "properties": {
        "vocabulary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "avoid": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "motion": {
      "type": "object",
      "description": "播放時的進場節奏：元件沒指定 enter 時依 data-role 取預設；stagger 是同一步驟內元件依序延遲的毫秒數，duration 是一次進場的毫秒數。靜態模式一律關閉",
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/definitions/enter"
        },
        "byRole": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/enter"
          }
        },
        "stagger": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "duration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "transition": {
          "enum": ["none", "fade", "push", "lift"],
          "description": "這套主題預設的換頁效果（deck.json 沒寫 transition 時用）；移植的主題包填來源模板的家族。沒寫就是 fade"
        }
      }
    },
    "source": {
      "type": "object",
      "description": "移植自外部模板時的來源與授權；開源時 THIRD_PARTY_NOTICES.md 要對得上",
      "additionalProperties": false,
      "required": [
        "name",
        "url",
        "author",
        "license"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "template": {
          "type": "string",
          "minLength": 1,
          "description": "原專案裡的模板 slug"
        }
      }
    }
  },
  "definitions": {
    "enter": {
      "enum": ["fade-up","fade","scale-in","slide-left","slide-right","wipe"]
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "use"
      ],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "use": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "face": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "weight"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900
        }
      }
    }
  }
}
