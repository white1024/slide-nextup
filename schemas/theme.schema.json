{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://slide-workflow.local/schemas/theme.schema.json",
  "title": "Theme",
  "description": "themes/<id>/theme.json: a theme describes the visual language only. Colours are named by purpose; font sizes and positions do not belong to a theme.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "colors",
    "typography",
    "spacing",
    "decoration"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Format version of theme.json; this engine understands 1 (pnpm theme:check verifies it)"
    },
    "engine": {
      "type": "string",
      "minLength": 1,
      "description": "Required engine version range (semver: >=0.1.0, ^0.1.0, 0.1.x, >=1.0.0 <2.0.0), checked against the version in package.json; absent means any"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "colors": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/color"
      },
      "required": [
        "paper",
        "ink",
        "muted",
        "accent",
        "surface",
        "line"
      ],
      "properties": {
        "paper": {
          "$ref": "#/definitions/color"
        },
        "ink": {
          "$ref": "#/definitions/color"
        },
        "muted": {
          "$ref": "#/definitions/color"
        },
        "accent": {
          "$ref": "#/definitions/color"
        },
        "surface": {
          "$ref": "#/definitions/color"
        },
        "line": {
          "$ref": "#/definitions/color"
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display",
        "body"
      ],
      "properties": {
        "display": {
          "$ref": "#/definitions/face"
        },
        "body": {
          "$ref": "#/definitions/face"
        }
      }
    },
    "spacing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "radius"
      ],
      "properties": {
        "radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      }
    },
    "decoration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vocabulary",
        "avoid"
      ],
      "properties": {
        "vocabulary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "avoid": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "motion": {
      "type": "object",
      "description": "Entrance rhythm during playback: family is the pack’s motion personality and sets the pace, the curve and the band the durations must stay in (crisp 300ms / 60ms stagger, band 150–400ms; soft 450ms / 90ms, band 300–800ms; minimal 220ms / 40ms, band 150–320ms); elements without an explicit enter take the default for their data-role; stagger is the delay in milliseconds between elements of one step, duration the length of one entrance, both overriding the family’s figures and checked by theme:lint against its band. Always off in static mode",
      "additionalProperties": false,
      "properties": {
        "family": {
          "enum": ["crisp", "soft", "minimal"],
          "description": "The pack’s one motion personality: crisp (quick and decisive), soft (Keynote-like, longer and rounder), minimal (short, plain ease). It decides the default entrance duration, stagger and curve; a pack has exactly one"
        },
        "default": {
          "$ref": "#/definitions/enter"
        },
        "byRole": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/enter"
          }
        },
        "stagger": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "duration": {
          "type": "integer",
          "minimum": 150,
          "maximum": 800,
          "description": "Length of one entrance in milliseconds; theme:lint also holds it to the family’s band"
        },
        "transition": {
          "enum": ["none", "fade", "rise", "settle", "dissolve", "breath", "push", "lift"],
          "description": "This theme’s default page transition family (used when deck.json has none): rise, settle, dissolve, breath, fade, push, lift or none; ported packs pick the family closest to their source template’s motion. Absent means fade"
        }
      }
    },
    "tones": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "description": "the data-tone values theme.css styles: inverse for a whole page, and the variants of one role a layout may ask for (second, third, accent, faint). theme:check warns when a layout uses a tone the theme does not style, and when a listed tone has no rule."
    },
    "source": {
      "type": "object",
      "description": "Source and licence when ported from an external template; THIRD_PARTY_NOTICES.md must match it",
      "additionalProperties": false,
      "required": [
        "name",
        "url",
        "author",
        "license"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "template": {
          "type": "string",
          "minLength": 1,
          "description": "The template’s slug in the original project"
        }
      }
    }
  },
  "definitions": {
    "enter": {
      "enum": ["fade-up","fade","scale-in","slide-left","slide-right","wipe","pop","blur","cascade","grow","draw","count"]
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "use"
      ],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "use": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "face": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "weight"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900
        }
      }
    }
  }
}
