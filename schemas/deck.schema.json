{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://slide-workflow.local/schemas/deck.schema.json",
  "title": "Deck",
  "description": "deck.json: the single source shared by the renderer, the browser editor and the agent. slides[] is produced by the agent, overrides are written by the editor; the two never overlap.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "theme", "canvas", "slides", "overrides"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/definitions/id" },
    "title": { "type": "string", "minLength": 1 },
    "theme": {
      "$ref": "#/definitions/id",
      "description": "Theme id, resolved to themes/<id>/"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "const": 1920 },
        "height": { "const": 1080 }
      }
    },
    "transition": {
      "enum": ["none", "fade", "push", "lift", "slide-left"],
      "description": "Page transition: fade cross-fades, push moves both pages together (reversed when going back), lift floats the new page over the old, none cuts; slide-left is the old name and plays as push. Without this field the theme’s motion.transition applies, and failing that fade. Static mode (?static=1, QA, export) never transitions"
    },
    "motion": {
      "enum": ["on", "off"],
      "description": "Master switch for element motion: off means no reveal steps and no entrances during playback, every press turns the page (page transitions still apply). Pressing M during playback overrides it for this browser without changing this value"
    },
    "lang": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "description": "BCP 47 tag of the content (en, zh-Hant, ja…), written to <html lang>. The scaffold copies the story’s frontmatter lang or guesses from the text’s script; absent means the renderer guesses the same way"
    },
    "story": {
      "type": "object",
      "description": "The story.md this deck was built from; the sha256 detects whether the story has changed since",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/slide" }
    },
    "overrides": {
      "type": "object",
      "description": "Manual overrides keyed by slideId/elementId. The agent must not touch these when regenerating slides",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]*/[A-Za-z][A-Za-z0-9_-]*$" },
      "additionalProperties": { "$ref": "#/definitions/override" }
    },
    "pages": {
      "type": "object",
      "description": "Slide-level overrides: playback order and hidden slides, written by the editor. story.md remains the source of the narrative; slides missing from order are inserted back at their relative position in story order",
      "additionalProperties": false,
      "properties": {
        "order": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/id" }
        },
        "hidden": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/id" }
        }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "layout", "slots", "elements"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "layout": {
          "$ref": "#/definitions/id",
          "description": "Layout id, resolved to layouts/<id>/ (a theme may override it with themes/<theme>/layouts/<id>/)"
        },
        "slots": {
          "type": "object",
          "description": "The content slots declared by the layout; every key must be one of this slide’s elements",
          "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
          "additionalProperties": { "$ref": "#/definitions/slot" }
        },
        "elements": {
          "type": "array",
          "description": "The editable elements declared by the layout, materialised here at generation time so deck.json describes itself",
          "minItems": 1,
          "items": { "$ref": "#/definitions/element" }
        },
        "notes": { "type": "string" }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "kind": { "enum": ["text", "image", "shape"] },
        "step": {
          "type": "integer",
          "minimum": 1,
          "description": "Reveal step: which press of “next” shows the element; absent means visible from the start"
        },
        "enter": {
          "enum": ["fade-up","fade","scale-in","slide-left","slide-right","wipe"],
          "description": "Entrance used when the step is reached; absent means the theme’s motion default for the data-role. Only affects elements with a step"
        }
      }
    },
    "hotspot": {
      "type": "object",
      "description": "A hotspot on an image: positioned in percentages of the image box, clicking it during playback jumps to the target slide",
      "additionalProperties": false,
      "required": ["target", "x", "y", "w", "h"],
      "properties": {
        "target": { "$ref": "#/definitions/id" },
        "x": { "type": "number", "minimum": 0, "maximum": 100 },
        "y": { "type": "number", "minimum": 0, "maximum": 100 },
        "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "label": { "type": "string" }
      }
    },
    "slot": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "text" },
            "value": { "type": "string" },
            "details": { "$ref": "#/definitions/slot", "description": "The full content shown on click; collapsed is the default and QA measures only the collapsed state" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "items"],
          "properties": {
            "type": { "const": "list" },
            "items": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "details": { "$ref": "#/definitions/slot" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "src"],
          "properties": {
            "type": { "const": "image" },
            "src": { "type": "string", "minLength": 1 },
            "alt": { "type": "string" },
            "hotspots": { "type": "array", "maxItems": 12, "items": { "$ref": "#/definitions/hotspot" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value", "label"],
          "properties": {
            "type": { "const": "metric" },
            "value": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "delta": { "type": "string" },
            "details": { "$ref": "#/definitions/slot" }
          }
        },
        {
          "type": "object",
          "description": "Chart: rendered as inline SVG; bar and line use the whole series, donut and progress use the first point against max (default 100); toggle makes the legend clickable during playback, and switched-off items leave the proportions",
          "additionalProperties": false,
          "required": ["type", "kind", "series"],
          "properties": {
            "type": { "const": "chart" },
            "kind": { "enum": ["bar", "line", "donut", "progress"] },
            "series": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "value"],
                "properties": {
                  "label": { "type": "string" },
                  "value": { "type": "number" }
                }
              }
            },
            "unit": { "type": "string" },
            "max": { "type": "number", "exclusiveMinimum": 0 },
            "toggle": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "description": "Tabs: several panels in one box, switched by clicking a tab during playback; static mode and QA only see the first panel",
          "additionalProperties": false,
          "required": ["type", "panels"],
          "properties": {
            "type": { "const": "tabs" },
            "panels": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "content"],
                "properties": {
                  "label": { "type": "string", "minLength": 1 },
                  "content": { "$ref": "#/definitions/slot" }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "description": "Table: header is optional; rows need not have equal cell counts, the renderer outputs them as given",
          "additionalProperties": false,
          "required": ["type", "rows"],
          "properties": {
            "type": { "const": "table" },
            "header": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        },
        {
          "type": "object",
          "description": "Code: plain monospace text without syntax colouring; lang is only a label",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "code" },
            "value": { "type": "string" },
            "lang": { "type": "string" }
          }
        },
        {
          "type": "object",
          "description": "Icon: a name from the built-in icon set (a Lucide subset, see src/render/icons.ts)",
          "additionalProperties": false,
          "required": ["type", "name"],
          "properties": {
            "type": { "const": "icon" },
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
          }
        }
      ]
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "rotation": { "type": "number" },
        "z": { "type": "integer" },
        "hidden": { "type": "boolean" },
        "text": { "type": "string", "description": "Only for elements whose kind is text" },
        "src": { "type": "string", "minLength": 1, "description": "Only for elements whose kind is image" },
        "details": { "type": "string", "description": "The details as text (same rules as the text override); an empty string removes the details. Only for elements whose kind is text" },
        "hotspots": { "type": "array", "maxItems": 12, "items": { "$ref": "#/definitions/hotspot" }, "description": "Replaces the image’s hotspots; an empty array means none. Only for elements whose kind is image" },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "color": { "type": "string" },
            "background": { "type": "string" },
            "fontFamily": { "type": "string" },
            "fontSize": { "type": "number", "exclusiveMinimum": 0 },
            "fontWeight": { "type": "integer", "minimum": 100, "maximum": 900 },
            "lineHeight": { "type": "number", "exclusiveMinimum": 0 },
            "letterSpacing": { "type": "number" },
            "textAlign": { "enum": ["left", "center", "right"] },
            "fontStyle": { "enum": ["italic", "normal"] },
            "textDecoration": { "enum": ["underline", "line-through", "none"] },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "borderRadius": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
