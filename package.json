{
  "name": "slide-nextup",
  "version": "0.1.0",
  "type": "module",
  "description": "Narrative-first slide decks: an agent confirms the story with you, then generates an HTML deck you can fully edit in the browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/white1024/slide-nextup.git"
  },
  "homepage": "https://github.com/white1024/slide-nextup#readme",
  "bugs": {
    "url": "https://github.com/white1024/slide-nextup/issues"
  },
  "keywords": [
    "slides",
    "presentation",
    "deck",
    "html",
    "claude-code",
    "codex",
    "agent",
    "skills",
    "narrative"
  ],
  "bin": {
    "slide-nextup": "bin/slide-nextup.mjs"
  },
  "files": [
    "bin",
    "dist",
    "layouts",
    "themes",
    "schemas",
    "templates",
    "examples/tidewatch-progress",
    "examples/story.sample.md",
    ".agents/skills/slide-brief",
    ".agents/skills/slide-story",
    ".agents/skills/slide-design",
    ".agents/skills/slide-build",
    ".agents/skills/slide-talk",
    "README.md",
    "LICENSE",
    "ATTRIBUTIONS.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "preflight": "node src/cli/preflight.ts",
    "build": "node tools/build.mjs",
    "prepack": "node tools/build.mjs",
    "render": "node src/cli/render.ts",
    "qa": "node src/cli/qa.ts",
    "deck:gallery": "node src/cli/deck-gallery.ts",
    "talk:scaffold": "node src/cli/talk-scaffold.ts",
    "talk:check": "node src/cli/talk-check.ts",
    "dev": "node src/cli/dev.ts",
    "browsers:install": "playwright install chromium",
    "story:check": "node src/cli/story-check.ts",
    "story:confirm": "node src/cli/story-confirm.ts",
    "story:apply-deck": "node src/cli/story-apply-deck.ts",
    "deck:scaffold": "node src/cli/deck-scaffold.ts",
    "deck:regenerate": "node src/cli/deck-scaffold.ts",
    "deck:sync-story": "node src/cli/deck-sync-story.ts",
    "layouts": "node src/cli/layouts.ts",
    "design:preview": "node src/cli/design-preview.ts",
    "design:set": "node src/cli/design-set.ts",
    "skills:sync": "node src/cli/skills-sync.ts sync",
    "skills:check": "node src/cli/skills-sync.ts check",
    "deck:validate": "node src/cli/deck-validate.ts",
    "deck:retheme": "node src/cli/deck-retheme.ts",
    "theme:lint": "node src/cli/theme-lint.ts",
    "theme:qa": "node src/cli/theme-qa.ts",
    "theme:check": "node src/cli/theme-check.ts",
    "theme:export": "node src/cli/theme-export.ts",
    "theme:import": "node src/cli/theme-import.ts",
    "layout:gallery": "node src/cli/layout-gallery.ts",
    "theme:gallery": "node src/cli/theme-gallery.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^24.13.3",
    "lucide-static": "^1.40.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "playwright": "^1.62.1",
    "yaml": "^2.9.0"
  }
}
