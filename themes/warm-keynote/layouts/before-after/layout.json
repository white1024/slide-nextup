{
  "id": "before-after",
  "name": "Before and after: Warm Keynote",
  "description": "A sunken card on the left holds the before steps as pills, a glass card on the right the after steps as teal pills, with a reminder below. Two bulleted lists would lose the visual contrast of fewer steps.",
  "content_relations": [
    "comparison",
    "sequence"
  ],
  "scene_roles": [
    "relationship",
    "evidence"
  ],
  "density": {
    "max_chars": 240,
    "max_elements": 13
  },
  "slots": {
    "kicker": {
      "type": "text",
      "required": false,
      "hint": "chapter label, e.g. \"01 — Why\"; numbered automatically by the scaffold when the slides in the story carry a chapter, otherwise left empty (an empty label takes the vertical bar with it)"
    },
    "meta": {
      "type": "text",
      "required": false,
      "hint": "pill tag top right: audience, phase or occasion, up to 10 characters, filled automatically from the first clause of occasion; leave empty when not needed"
    },
    "title": {
      "type": "text",
      "required": true,
      "hint": "the claim of the slide in one sentence, up to 2 lines and 24 characters; *keyword* marks an emphasis"
    },
    "before-label": {
      "type": "text",
      "required": false,
      "hint": "left column eyebrow, e.g. \"BEFORE - 5 steps\""
    },
    "before": {
      "type": [
        "list",
        "text"
      ],
      "required": true,
      "hint": "the steps before, a pill for every step"
    },
    "after-label": {
      "type": "text",
      "required": false,
      "hint": "right column eyebrow, e.g. \"AFTER - 3 steps\""
    },
    "after": {
      "type": [
        "list",
        "text"
      ],
      "required": true,
      "hint": "the steps after, a pill for every step"
    },
    "caption": {
      "type": "text",
      "required": false,
      "hint": "a closing supplement or reminder, 1 to 2 lines"
    },
    "page": {
      "type": "text",
      "required": false,
      "hint": "page number pill, filled automatically (\"01 / 08\")"
    }
  },
  "elements": [
    {
      "id": "kicker",
      "kind": "text"
    },
    {
      "id": "meta",
      "kind": "text"
    },
    {
      "id": "title",
      "kind": "text"
    },
    {
      "id": "before-box",
      "kind": "shape"
    },
    {
      "id": "before-label",
      "kind": "text"
    },
    {
      "id": "before",
      "kind": "text"
    },
    {
      "id": "after-box",
      "kind": "shape"
    },
    {
      "id": "after-label",
      "kind": "text"
    },
    {
      "id": "after",
      "kind": "text"
    },
    {
      "id": "caption",
      "kind": "text"
    },
    {
      "id": "progress",
      "kind": "shape"
    },
    {
      "id": "page",
      "kind": "text"
    }
  ],
  "sample": {
    "kicker": {
      "type": "text",
      "value": "01 — Why"
    },
    "meta": {
      "type": "text",
      "value": "Team leads"
    },
    "page": {
      "type": "text",
      "value": "03 / 08"
    },
    "title": {
      "type": "text",
      "value": "Not a new meeting: put the update next to the work"
    },
    "before-label": {
      "type": "text",
      "value": "BEFORE - 5 steps"
    },
    "before": {
      "type": "list",
      "items": [
        "Book the room",
        "Collect the numbers",
        "Build the deck",
        "Present",
        "Send the notes"
      ]
    },
    "after-label": {
      "type": "text",
      "value": "AFTER - 3 steps"
    },
    "after": {
      "type": "list",
      "items": [
        "Write the update",
        "Read and comment",
        "Decide in a short call"
      ]
    },
    "caption": {
      "type": "text",
      "value": "The two steps that vanish are exactly where the hour went."
    }
  }
}
