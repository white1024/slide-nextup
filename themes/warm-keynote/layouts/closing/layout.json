{
  "id": "closing",
  "name": "Closing: Warm Keynote",
  "description": "A short teal rule, one closing headline, a lede and a reminder, then a row of pills: the main call to action plus a few key points. A \"thank you\" slide would lose the gesture of handing the next step to the audience.",
  "content_relations": [
    "closing",
    "statement"
  ],
  "scene_roles": [
    "close"
  ],
  "density": {
    "max_chars": 220,
    "max_elements": 8
  },
  "slots": {
    "title": {
      "type": "text",
      "required": true,
      "hint": "closing claim, up to 2 lines"
    },
    "body": {
      "type": "text",
      "required": false,
      "hint": "a one-line lede"
    },
    "caption": {
      "type": "text",
      "required": false,
      "hint": "a one-line reminder that introduces the pills"
    },
    "cta": {
      "type": "text",
      "required": true,
      "hint": "the main call to action, one short phrase, up to 12 characters"
    },
    "evidence": {
      "type": [
        "list",
        "text"
      ],
      "required": false,
      "hint": "a few key points, a pill for every point"
    },
    "page": {
      "type": "text",
      "required": false,
      "hint": "page number pill, filled automatically (\"01 / 08\")"
    }
  },
