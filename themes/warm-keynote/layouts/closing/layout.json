  "sample": {
    "title": {
      "type": "text",
      "value": "Whenever you wonder \"does this need a meeting?\", write it down first."
    },
    "body": {
      "type": "text",
      "value": "Whether you want a second pair of eyes on it or the template set up for you, you are welcome."
    },
    "caption": {
      "type": "text",
      "value": "When you are ready to start, we will settle these four questions with you:"
    },
    "cta": {
      "type": "text",
      "value": "Try it for a month"
    },
    "evidence": {
      "type": "list",
      "items": [
        "Which sections to keep",
        "Who writes what",
        "When to comment",
        "What still needs a call"
      ]
    },
    "page": {
      "type": "text",
      "value": "08 / 08"
    }
