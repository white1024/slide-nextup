{
  "id": "chart-aside",
  "name": "圖表與旁註：暖色 Keynote",
  "description": "章節頭下面左邊一張圖表（長條、進度、折線、環形），右邊一張玻璃卡片放旁註或關鍵數字，底下一行註記。改成純表格會失去比例感。",
  "content_relations": [
    "evidence",
    "comparison",
    "sequence"
  ],
  "scene_roles": [
    "evidence",
    "relationship"
  ],
  "density": {
    "max_chars": 260,
    "max_elements": 9
  },
  "slots": {
    "kicker": {
      "type": "text",
      "required": false,
      "hint": "章節標籤，例如「01 — 為什麼做」；敘事逐頁有 chapter 時 scaffold 自動編號，否則留空（留空就連豎條一起消失）"
    },
    "meta": {
      "type": "text",
      "required": false,
      "hint": "右上角的膠囊標籤：對象、階段或場合，十字以內，自動填 occasion 的第一句；不需要就留空"
    },
    "title": {
      "type": "text",
      "required": true,
      "hint": "一句話的頁面主張，兩行以內、二十四字以內；可用 *關鍵詞* 強調"
    },
    "chart": {
      "type": "chart",
      "required": true,
      "hint": "圖表；progress 最像原版的長條列"
    },
    "aside": {
      "type": [
        "metric",
        "text",
        "chart"
      ],
      "required": false,
      "hint": "旁註：一個關鍵數字或一段話"
    },
    "caption": {
      "type": "text",
      "required": false,
      "hint": "一行註記"
    },
    "page": {
      "type": "text",
      "required": false,
      "hint": "頁碼膠囊，自動填「01 / 08」"
    }
  },
  "elements": [
    {
      "id": "kicker",
      "kind": "text"
    },
    {
      "id": "meta",
      "kind": "text"
    },
    {
      "id": "title",
      "kind": "text"
    },
    {
      "id": "chart",
      "kind": "text"
    },
    {
      "id": "aside",
      "kind": "text"
    },
    {
      "id": "caption",
      "kind": "text"
    },
    {
      "id": "progress",
      "kind": "shape"
    },
    {
      "id": "page",
      "kind": "text"
    }
  ],
  "sample": {
    "kicker": {
      "type": "text",
      "value": "01 — 為什麼做"
    },
    "meta": {
      "type": "text",
      "value": "員工端"
    },
    "page": {
      "type": "text",
      "value": "03 / 08"
    },
    "title": {
      "type": "text",
      "value": "先做用量最大的三張單"
    },
    "chart": {
      "type": "chart",
      "kind": "bar",
      "series": [
        {
          "label": "請假單",
          "value": 37
        },
        {
          "label": "加班單",
          "value": 28
        },
        {
          "label": "忘刷單",
          "value": 20
        },
        {
          "label": "公出差旅單",
          "value": 9
        }
      ],
      "unit": "%",
      "toggle": true
    },
    "aside": {
      "type": "metric",
      "value": "85%",
      "label": "前三張加總",
      "delta": "是員工最常用的表單"
    },
    "caption": {
      "type": "text",
      "value": "各產業前三名一致；播放時點圖例可以拿掉一項再比。"
    }
  }
}
