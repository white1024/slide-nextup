{
  "id": "process",
  "name": "Process: Warm Keynote",
  "description": "One horizontal flow: six pill nodes and five arrows, a lede above and a reminder below. A bulleted list would lose the effect of taking in the whole line at a glance.",
  "content_relations": [
    "sequence"
  ],
  "scene_roles": [
    "relationship",
    "map"
  ],
  "density": {
    "max_chars": 260,
    "max_elements": 19
  },
  "slots": {
    "kicker": {
      "type": "text",
      "required": false,
      "hint": "chapter label, e.g. \"01 — Why\"; numbered automatically by the scaffold when the slides in the story carry a chapter, otherwise left empty (an empty label takes the vertical bar with it)"
    },
    "meta": {
      "type": "text",
      "required": false,
      "hint": "pill tag top right: audience, phase or occasion, up to 10 characters, filled automatically from the first clause of occasion; leave empty when not needed"
    },
    "title": {
      "type": "text",
      "required": true,
      "hint": "the claim of the slide in one sentence, up to 2 lines and 24 characters; *keyword* marks an emphasis"
    },
    "subtitle": {
      "type": "text",
      "required": false,
      "hint": "a one-line lede, up to 50 characters"
    },
    "step-1": {
      "type": [
        "text",
        "metric"
      ],
      "required": true,
      "hint": "step name, up to 7 characters per line, up to 2 lines"
    },
    "step-2": {
      "type": [
        "text",
        "metric"
      ],
      "required": true,
      "hint": "same as above; leave empty when not needed"
    },
    "step-3": {
      "type": [
        "text",
        "metric"
      ],
      "required": true,
      "hint": "same as above; leave empty when not needed"
    },
    "step-4": {
      "type": [
        "text",
        "metric"
      ],
      "required": false,
      "hint": "same as above; leave empty when not needed"
    },
    "step-5": {
      "type": [
        "text",
        "metric"
      ],
      "required": false,
      "hint": "same as above; leave empty when not needed"
    },
    "step-6": {
      "type": [
        "text",
        "metric"
      ],
      "required": false,
      "hint": "same as above; leave empty when not needed"
    },
    "caption": {
      "type": "text",
      "required": false,
      "hint": "a reminder for the process: what is most easily missed"
    },
    "page": {
      "type": "text",
      "required": false,
      "hint": "page number pill, filled automatically (\"01 / 08\")"
    }
  },
