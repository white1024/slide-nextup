    "statement"
  ],
  "scene_roles": [
    "pause",
    "hero",
    "close"
  ],
  "density": {
    "max_chars": 100,
    "max_elements": 8
  },
  "slots": {
    "kicker": {
      "type": "text",
      "required": false,
      "hint": "章節標籤，例如「01 — 為什麼做」；敘事逐頁有 chapter 時 scaffold 自動編號，否則留空（留空就連豎條一起消失）"
    },
    "meta": {
      "type": "text",
      "required": false,
      "hint": "右上角的膠囊標籤：對象、階段或場合，十字以內，自動填 occasion 的第一句；不需要就留空"
    },
    "title": {
      "type": "text",
      "required": true,
      "hint": "引言本文，三行以內、六十字以內；可用 *關鍵詞* 換青綠"
    },
    "caption": {
      "type": "text",
      "required": false,
      "hint": "出處或說明"
    },
    "page": {
      "type": "text",
      "required": false,
      "hint": "頁碼膠囊，自動填「01 / 08」"
    }
  },
