    },
    {
      "id": "body",
      "kind": "text"
    },
    {
      "id": "footrule",
      "kind": "shape"
    },
    {
      "id": "meta",
      "kind": "text"
    },
    {
      "id": "progress",
      "kind": "shape"
    },
    {
      "id": "page",
      "kind": "text"
    }
  ],
