  "sample": {
    "kicker": {
      "type": "text",
      "value": "02 — Where we stand"
    },
    "meta": {
      "type": "text",
      "value": "Quarterly review"
    },
    "page": {
      "type": "text",
      "value": "03 / 10"
    },
    "title": {
      "type": "text",
      "value": "Four changes in how we work"
    },
    "head-1": {
      "type": "text",
      "value": "Assume fixes cost more"
    },
    "list-1": {
      "type": "list",
      "items": [
        "Each fix is budgeted at two weeks or more",
        "Small fixes no longer jump the queue",
        "Measure first, so we fix the right thing"
      ]
    },
    "head-2": {
      "type": "text",
      "value": "A more cautious schedule"
    },
    "list-2": {
      "type": "list",
      "items": [
        "At most three items in progress at once",
        "Every item has a stop-loss point",
        "Anything open over a month is escalated"
      ]
    },
    "head-3": {
      "type": "text",
      "value": "Delivery first"
    },
    "list-3": {
      "type": "list",
      "items": [
        "Fix what hurts delivery first",
        "Features come after the health targets",
        "Commit to only three things a quarter"
      ]
    },
    "head-4": {
      "type": "text",
      "value": "Bottom-up reporting"
    },
    "list-4": {
      "type": "list",
      "items": [
        "The front line reports issues directly",
        "A public ranking every two weeks",
        "Data where everyone can see it"
      ]
    }
  }
