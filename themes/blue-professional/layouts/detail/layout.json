{
  "id": "detail",
  "name": "Detail: blue professional",
  "description": "Four tinted blocks in two columns and two rows, each with a bold heading and two or three blue-ruled points. One long list would lose the grouping of four things each in its own set.",
  "content_relations": [
    "list",
    "hierarchy",
    "evidence"
  ],
  "scene_roles": [
    "evidence",
    "map"
