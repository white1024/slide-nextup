    },
    "right-items": {
      "type": "list",
      "required": true,
      "hint": "3 to 4 items, up to 2 lines each"
    },
    "page": {
      "type": "text",
      "required": false,
      "hint": "page number, filled automatically (\"01 / 08\")"
    }
