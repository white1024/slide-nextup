{
  "id": "quote",
  "name": "引言：藍色專業",
  "description": "置中的一段引言：上方一個淡藍的引號、粗體大字，底下一行出處；左上一個細圓環、右下一個淡藍圓點。改成一般文字頁會失去停頓感。",
  "content_relations": [
    "statement"
  ],
  "scene_roles": [
    "pause",
    "hero",
    "close"
  ],
  "density": {
    "max_chars": 120,
    "max_elements": 9
  },
  "slots": {
    "kicker": {
      "type": "text",
      "required": false,
      "hint": "左上角的章節標籤，例如「01 — 為什麼做」；敘事逐頁有 chapter 時 scaffold 自動編號，否則留空"
    },
    "meta": {
      "type": "text",
      "required": false,
      "hint": "右上角的圓角標籤：對象、階段或場合，十字以內，自動填 occasion 的第一句；不需要就留空"
    },
    "title": {
      "type": "text",
      "required": true,
      "hint": "引言本文，三行以內、六十字以內；可用 *關鍵詞* 換藍色"
    },
    "caption": {
      "type": "text",
      "required": false,
      "hint": "出處：誰說的、在哪個場合，一行"
    },
    "page": {
      "type": "text",
      "required": false,
      "hint": "頁碼，自動填「01 / 08」"
    }
  },
