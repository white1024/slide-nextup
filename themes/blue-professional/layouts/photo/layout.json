  "slots": {
    "kicker": {
      "type": "text",
      "required": false,
      "hint": "左上角的章節標籤，例如「01 — 為什麼做」；敘事逐頁有 chapter 時 scaffold 自動編號，否則留空"
    },
    "meta": {
      "type": "text",
      "required": false,
      "hint": "右上角的圓角標籤：對象、階段或場合，十字以內，自動填 occasion 的第一句；不需要就留空"
    },
    "title": {
      "type": "text",
      "required": true,
      "hint": "一句話的頁面主張，兩行以內、二十六字以內；可用 *關鍵詞* 強調（藍色）"
    },
    "photo": {
      "type": "image",
      "required": true,
      "hint": "圖片，建議 1766×620 或同比例，會以 cover 方式裁切；可加 hotspots（播放時點擊跳頁的區域，百分比定位）"
    },
    "caption": {
      "type": "text",
      "required": false,
      "hint": "一行圖說"
    },
    "page": {
      "type": "text",
      "required": false,
      "hint": "頁碼，自動填「01 / 08」"
    }
