{
  "id": "data-table",
  "name": "Table",
  "description": "A title, a table of up to 6 rows and 5 columns, and a source note. Cards would lose the column-by-column comparability.",
  "content_relations": ["comparison", "evidence", "list"],
  "scene_roles": ["evidence"],
  "density": { "max_chars": 640, "max_elements": 6 },
  "slots": {
    "brand": { "type": "text", "required": false, "hint": "top bar left, filled automatically" },
    "meta": { "type": "text", "required": false, "hint": "top bar right, filled automatically" },
    "title": { "type": "text", "required": true, "hint": "the table's conclusion, one line" },
    "table": { "type": "table", "required": true, "hint": "one header row, up to 6 rows, 1 to 10 characters per cell" },
    "caption": { "type": "text", "required": false, "hint": "data source, one line" },
    "page": { "type": "text", "required": false, "hint": "page number, filled automatically" }
  },
  "elements": [
    { "id": "brand", "kind": "text" },
    { "id": "meta", "kind": "text" },
    { "id": "title", "kind": "text" },
    { "id": "table", "kind": "text" },
    { "id": "caption", "kind": "text" },
    { "id": "page", "kind": "text" }
  ],
  "sample": {
    "brand": { "type": "text", "value": "Confirm the story before the slides" },
    "meta": { "type": "text", "value": "Weekly meeting pitch - 2026-09" },
    "title": { "type": "text", "value": "One deck in six was not about order" },
    "table": {
      "type": "table",
      "header": ["Deck", "Rounds", "From order", "From layout", "Note"],
      "rows": [
        ["Q1 sales review", "5", "4", "1", "Agenda moved 3 times"],
        ["New product pitch", "4", "3", "1", ""],
        ["Quarterly OKRs", "3", "2", "1", ""],
        ["Customer case", "4", "1", "3", "*only* layout-led"],
        ["Annual budget", "5", "4", "1", "Chapters swapped"],
        ["Training material", "3", "2", "1", ""]
      ]
    },
    "caption": { "type": "text", "value": "Last quarter: six decks, 24 revision rounds, logged one by one." },
    "page": { "type": "text", "value": "03 / 08" }
  }
}
