    "title": { "type": "text", "required": true, "hint": "表格的結論，一行" },
    "table": { "type": "table", "required": true, "hint": "header 一列、rows 最多六列，每格一到十個字" },
    "caption": { "type": "text", "required": false, "hint": "資料來源，一行" },
    "page": { "type": "text", "required": false, "hint": "頁碼，自動填" }
  },
  "elements": [
    { "id": "brand", "kind": "text" },
    { "id": "meta", "kind": "text" },
    { "id": "title", "kind": "text" },
    { "id": "table", "kind": "text" },
    { "id": "caption", "kind": "text" },
    { "id": "page", "kind": "text" }
  ],
