    "meta": { "type": "text", "required": false, "hint": "頂欄右，自動填" },
    "title": { "type": "text", "required": true, "hint": "一行主張，二十四字以內" },
    "main": { "type": ["list", "text"], "required": true, "hint": "主欄：三到五條，或一段" },
    "aside": { "type": ["text", "metric"], "required": false, "hint": "側欄：一個大數字或一句話" },
    "page": { "type": "text", "required": false, "hint": "頁碼，自動填" }
  },
  "elements": [
    { "id": "brand", "kind": "text" },
    { "id": "meta", "kind": "text" },
    { "id": "title", "kind": "text" },
    { "id": "main", "kind": "text" },
    { "id": "divider", "kind": "shape" },
    { "id": "aside", "kind": "text" },
    { "id": "page", "kind": "text" }
  ],
