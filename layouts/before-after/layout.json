{
  "id": "before-after",
  "name": "Before and after",
  "description": "Two cards with an arrow between them: the left is today, the right is after the change. A plain two-column split would lose the directed, cause-and-effect reading order.",
  "content_relations": ["comparison", "sequence"],
  "scene_roles": ["relationship", "evidence"],
  "density": { "max_chars": 400, "max_elements": 9 },
  "slots": {
    "brand": { "type": "text", "required": false, "hint": "top bar left, filled automatically" },
    "meta": { "type": "text", "required": false, "hint": "top bar right, filled automatically" },
    "title": { "type": "text", "required": true, "hint": "a one-line claim" },
    "before-label": { "type": "text", "required": false, "hint": "left column name, e.g. \"Today\"" },
    "after-label": { "type": "text", "required": false, "hint": "right column name, e.g. \"New flow\"" },
    "before": { "type": ["list", "text"], "required": true, "hint": "today: 3 to 4 items" },
    "after": { "type": ["list", "text"], "required": true, "hint": "after: 3 to 4 items, in the same order as the left" },
    "page": { "type": "text", "required": false, "hint": "page number, filled automatically" }
  },
  "elements": [
    { "id": "brand", "kind": "text" },
    { "id": "meta", "kind": "text" },
    { "id": "title", "kind": "text" },
    { "id": "before-label", "kind": "text" },
    { "id": "after-label", "kind": "text" },
    { "id": "before", "kind": "text" },
    { "id": "arrow", "kind": "shape" },
    { "id": "after", "kind": "text" },
    { "id": "page", "kind": "text" }
  ],
  "sample": {
    "brand": { "type": "text", "value": "Confirm the story before the slides" },
    "meta": { "type": "text", "value": "Weekly meeting pitch - 2026-09" },
    "title": { "type": "text", "value": "Move story sign-off ahead of layout" },
    "before-label": { "type": "text", "value": "Today" },
    "after-label": { "type": "text", "value": "New flow" },
    "before": { "type": "list", "items": ["Open the app, pick a template", "Pour content into the layout", "Rehearse, find the order is wrong", "Reorder, rehearse again"] },
    "after": { "type": "list", "items": ["Write the story file", "*You confirm* the order and messages", "Generate the layouts", "Only tweak wording"] },
    "page": { "type": "text", "value": "04 / 08" }
  }
}
