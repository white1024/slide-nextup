{
  "id": "code-block",
  "name": "程式碼區塊",
  "description": "標題、一塊等寬字的程式碼或指令（最多十行、每行四十字）、一到兩行說明。改成一般文字會失去「每個字元都對齊」的可讀性。",
  "content_relations": ["evidence", "sequence", "statement"],
  "scene_roles": ["evidence", "relationship"],
  "density": { "max_chars": 800, "max_elements": 6 },
  "slots": {
    "brand": { "type": "text", "required": false, "hint": "頂欄左，自動填" },
    "meta": { "type": "text", "required": false, "hint": "頂欄右，自動填" },
    "title": { "type": "text", "required": true, "hint": "這段程式碼證明什麼，一行" },
    "code": { "type": "code", "required": true, "hint": "最多十行、每行四十字；lang 只是標籤" },
    "caption": { "type": "text", "required": false, "hint": "一行說明" },
    "page": { "type": "text", "required": false, "hint": "頁碼，自動填" }
  },
  "elements": [
    { "id": "brand", "kind": "text" },
    { "id": "meta", "kind": "text" },
    { "id": "title", "kind": "text" },
    { "id": "code", "kind": "text" },
    { "id": "caption", "kind": "text" },
    { "id": "page", "kind": "text" }
  ],
  "sample": {
    "brand": { "type": "text", "value": "先確認敘事，再做簡報" },
    "meta": { "type": "text", "value": "週會提案 · 2026-09" },
    "title": { "type": "text", "value": "關卡是工具強制的，不是靠人記" },
    "code": {
      "type": "code",
      "lang": "bash",
      "value": "$ pnpm story:check decks/q3/story.md\n通過：0 個錯誤，0 個警告\n\n$ pnpm deck:scaffold decks/q3/story.md --theme ink-paper\n拒絕：敘事尚未確認（story.confirmed.json 不存在）\n\n$ pnpm story:confirm decks/q3/story.md\n已記錄確認：8 頁，sha256 edce99f4"
    },
    "caption": { "type": "text", "value": "未確認或敘事改過，生成指令會直接拒絕；沒有 --force 以外的繞法。" },
    "page": { "type": "text", "value": "05 / 08" }
  }
}
