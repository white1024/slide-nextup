{
  "id": "comparison",
  "name": "Two-column comparison",
  "description": "A title and a list on each side with a divider between them. A single table would lose the rhythm of two sides that each read as a paragraph.",
  "content_relations": ["comparison"],
  "scene_roles": ["evidence", "relationship"],
  "density": { "max_chars": 320, "max_elements": 6 },
  "slots": {
    "title": { "type": "text", "required": true, "hint": "the conclusion of the comparison, one line" },
    "left-title": { "type": "text", "required": true, "hint": "left column name, 2 to 6 characters" },
    "left-items": { "type": "list", "required": true, "hint": "3 to 5 items" },
    "right-title": { "type": "text", "required": true, "hint": "right column name, 2 to 6 characters" },
    "right-items": { "type": "list", "required": true, "hint": "3 to 5 items" }
  },
  "elements": [
    { "id": "title", "kind": "text" },
    { "id": "divider", "kind": "shape" },
    { "id": "left-title", "kind": "text" },
    { "id": "left-items", "kind": "text" },
    { "id": "right-title", "kind": "text" },
    { "id": "right-items", "kind": "text" }
  ],
  "sample": {
    "title": { "type": "text", "value": "The tool is fine; the order is wrong" },
    "left-title": { "type": "text", "value": "Today" },
    "left-items": {
      "type": "list",
      "items": ["Open the slide app", "Lay out the slides", "Rehearse", "Find the order is wrong", "Reorder"]
    },
    "right-title": { "type": "text", "value": "Target" },
    "right-items": { "type": "list", "items": ["Write the story", "Confirm", "Generate layouts", "Only tweak"] }
  }
}
