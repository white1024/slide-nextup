{
  "id": "two-cols-header",
  "name": "Summary over two columns",
  "description": "A full-width summary under the title, then two cards left and right. Plain two columns would lose the structure of stating the shared premise before splitting in two.",
  "content_relations": ["comparison", "list", "evidence"],
  "scene_roles": ["evidence", "relationship"],
  "density": { "max_chars": 420, "max_elements": 7 },
  "slots": {
    "brand": { "type": "text", "required": false, "hint": "top bar left, filled automatically" },
    "meta": { "type": "text", "required": false, "hint": "top bar right, filled automatically" },
    "title": { "type": "text", "required": true, "hint": "a one-line claim" },
    "body": { "type": "text", "required": false, "hint": "summary, 1 to 2 lines" },
    "left": { "type": ["list", "text", "metric"], "required": true, "hint": "left column: a list, a short phrase or a number" },
    "right": { "type": ["list", "text", "metric"], "required": true, "hint": "right column: same as above" },
    "page": { "type": "text", "required": false, "hint": "page number, filled automatically" }
  },
  "elements": [
    { "id": "brand", "kind": "text" },
    { "id": "meta", "kind": "text" },
    { "id": "title", "kind": "text" },
    { "id": "body", "kind": "text" },
    { "id": "left", "kind": "text" },
    { "id": "right", "kind": "text" },
    { "id": "page", "kind": "text" }
  ],
  "sample": {
    "brand": { "type": "text", "value": "Confirm the story before the slides" },
    "meta": { "type": "text", "value": "Weekly meeting pitch - 2026-09" },
    "title": { "type": "text", "value": "Same proposal, two ways of working" },
    "body": { "type": "text", "value": "Same tools, same presenter; the difference is when the story gets confirmed." },
    "left": { "type": "list", "items": ["Lay out first, think about order later", "Only rehearsal shows what to change", "Four rounds on average"] },
    "right": { "type": "list", "items": ["Confirm the story, then generate layouts", "Edits change wording, not layout", "Zero layout rounds"] },
    "page": { "type": "text", "value": "04 / 08" }
  }
}
