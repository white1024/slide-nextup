{
  "id": "icon-cards",
  "name": "Icon cards",
  "description": "Three cards, each topped by an icon so the three things can be told apart without reading. Text-only cards would lose the speed of knowing at a glance which three kinds they are.",
  "content_relations": ["list", "hierarchy", "evidence"],
  "scene_roles": ["map", "evidence"],
  "density": { "max_chars": 360, "max_elements": 10 },
  "slots": {
    "brand": { "type": "text", "required": false, "hint": "top bar left, filled automatically" },
    "meta": { "type": "text", "required": false, "hint": "top bar right, filled automatically" },
    "title": { "type": "text", "required": true, "hint": "a one-line claim" },
    "card-1": { "type": ["text", "metric"], "required": true, "hint": "a short phrase or a big number" },
    "card-2": { "type": ["text", "metric"], "required": true, "hint": "same as above" },
    "card-3": { "type": ["text", "metric"], "required": false, "hint": "same as above" },
    "icon-1": { "type": "icon", "required": false, "hint": "icon name, e.g. check, cpu, rocket (see src/render/icons.ts)" },
    "icon-2": { "type": "icon", "required": false, "hint": "same as above" },
    "icon-3": { "type": "icon", "required": false, "hint": "same as above" },
    "page": { "type": "text", "required": false, "hint": "page number, filled automatically" }
  },
  "elements": [
    { "id": "brand", "kind": "text" },
    { "id": "meta", "kind": "text" },
    { "id": "title", "kind": "text" },
    { "id": "card-1", "kind": "text" },
    { "id": "card-2", "kind": "text" },
    { "id": "card-3", "kind": "text" },
    { "id": "icon-1", "kind": "text" },
    { "id": "icon-2", "kind": "text" },
    { "id": "icon-3", "kind": "text" },
    { "id": "page", "kind": "text" }
  ],
  "sample": {
    "brand": { "type": "text", "value": "Confirm the story before the slides" },
    "meta": { "type": "text", "value": "Weekly meeting pitch - 2026-09" },
    "title": { "type": "text", "value": "Three things the new flow guarantees" },
    "card-1": { "type": "text", "value": "Not one slide is generated before the story is confirmed." },
    "card-2": { "type": "text", "value": "Three visual directions are chosen from real covers, not adjectives." },
    "card-3": { "type": "text", "value": "Regenerating a slide always keeps manual edits." },
    "icon-1": { "type": "icon", "name": "shield-check" },
    "icon-2": { "type": "icon", "name": "eye" },
    "icon-3": { "type": "icon", "name": "refresh-cw" },
    "page": { "type": "text", "value": "06 / 08" }
  }
}
