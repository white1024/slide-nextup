    "card-1": { "type": ["text", "metric"], "required": true, "hint": "短句或 metric（大數字、標籤、變化）；可加 details（播放時點卡片展開的完整內容）" },
    "card-2": { "type": ["text", "metric"], "required": true, "hint": "同上" },
    "card-3": { "type": ["text", "metric"], "required": false, "hint": "同上；只有兩張時用覆寫隱藏或留空" }
  },
  "elements": [
    { "id": "title", "kind": "text" },
    { "id": "card-1", "kind": "text" },
    { "id": "card-2", "kind": "text" },
    { "id": "card-3", "kind": "text" }
  ],
  "sample": {
