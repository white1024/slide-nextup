    "card-1": {
      "type": "metric",
      "value": "0",
      "label": "試做 A 的版面修改輪數",
      "delta": "敘事改兩輪",
      "details": {
        "type": "list",
        "items": ["第一輪：對調第 2、3 章的順序", "第二輪：把數據頁拆成兩頁", "版面從頭到尾沒有動過"]
      }
    },
    "card-2": { "type": "metric", "value": "0", "label": "試做 B 的版面修改輪數", "delta": "敘事改一輪" },
