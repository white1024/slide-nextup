{
  "id": "hero",
  "name": "封面：Hero",
  "description": "網站首屏式的封面：頂欄家具、帶錨點的 kicker、大標、一段導語、三個 KPI 數字，右側一團光暈。改成只有標題的封面會失去「一頁就把主張、證據與規模講完」的份量。",
  "content_relations": ["statement", "evidence"],
  "scene_roles": ["hero"],
  "density": { "max_chars": 260, "max_elements": 14 },
  "slots": {
    "brand": { "type": "text", "required": false, "hint": "頂欄左：簡報或系列名，自動填敘事標題的系列名（冒號前）" },
    "meta": { "type": "text", "required": false, "hint": "頂欄右：場合或日期，自動填 occasion 的第一句（十字以內）" },
    "kicker": { "type": "text", "required": false, "hint": "錨點後的小標，四到十二個字" },
    "title": { "type": "text", "required": true, "hint": "主張式標題，一到兩行，十六字以內；可用 *關鍵詞* 強調" },
    "subtitle": { "type": "text", "required": false, "hint": "一到兩行導語，五十字以內" },
    "stat-1": { "type": ["text", "metric"], "required": false, "hint": "KPI：大數字加標籤，或一句短語" },
    "stat-2": { "type": ["text", "metric"], "required": false, "hint": "同上" },
    "stat-3": { "type": ["text", "metric"], "required": false, "hint": "同上；沒有第三個就留空" },
    "page": { "type": "text", "required": false, "hint": "頁碼，自動填「01 / 08」" }
  },
  "elements": [
    { "id": "glow", "kind": "shape" },
    { "id": "corner-tl", "kind": "shape" },
    { "id": "corner-br", "kind": "shape" },
    { "id": "brand", "kind": "text" },
    { "id": "meta", "kind": "text" },
    { "id": "anchor", "kind": "shape" },
    { "id": "kicker", "kind": "text" },
    { "id": "title", "kind": "text" },
    { "id": "subtitle", "kind": "text" },
    { "id": "stat-1", "kind": "text" },
    { "id": "stat-2", "kind": "text" },
    { "id": "stat-3", "kind": "text" },
    { "id": "page", "kind": "text" }
  ],
  "sample": {
    "brand": { "type": "text", "value": "先確認敘事，再做簡報" },
    "meta": { "type": "text", "value": "週會提案 · 2026-09" },
    "kicker": { "type": "text", "value": "為什麼一直改版面" },
    "title": { "type": "text", "value": "我們改簡報的時間，花在*版面*" },
    "subtitle": { "type": "text", "value": "上季六份簡報平均改四輪，其中三輪只動版面；敘事先被確認，版面修改就會消失。" },
    "stat-1": { "type": "metric", "value": "4", "label": "平均改版輪數" },
    "stat-2": { "type": "metric", "value": "3", "label": "其中只動版面" },
    "stat-3": { "type": "metric", "value": "0", "label": "新流程的版面修改" },
    "page": { "type": "text", "value": "01 / 08" }
