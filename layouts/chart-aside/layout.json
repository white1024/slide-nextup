{
  "id": "chart-aside",
  "name": "Chart with aside",
  "description": "A chart (bar, line, donut or progress) fills the left two thirds; a card on the right holds the headline number or a one-sentence reading, with the source below. A table would lose the at-a-glance sense of high and low.",
  "content_relations": ["evidence", "comparison", "sequence"],
  "scene_roles": ["evidence", "relationship"],
  "density": { "max_chars": 520, "max_elements": 7 },
  "slots": {
    "brand": { "type": "text", "required": false, "hint": "top bar left, filled automatically" },
    "meta": { "type": "text", "required": false, "hint": "top bar right, filled automatically" },
    "title": { "type": "text", "required": true, "hint": "the chart's conclusion, one line" },
    "chart": { "type": "chart", "required": true, "hint": "kind: bar | line | donut | progress; 3 to 8 series points; with toggle true the legend is clickable during playback" },
    "aside": { "type": ["metric", "text", "chart"], "required": false, "hint": "one headline number, a one-sentence reading, or a small donut / progress chart" },
    "caption": { "type": "text", "required": false, "hint": "data source and measurement conditions, one line" },
    "page": { "type": "text", "required": false, "hint": "page number, filled automatically" }
  },
  "elements": [
    { "id": "brand", "kind": "text" },
    { "id": "meta", "kind": "text" },
    { "id": "title", "kind": "text" },
    { "id": "chart", "kind": "text" },
    { "id": "aside", "kind": "text" },
    { "id": "caption", "kind": "text" },
    { "id": "page", "kind": "text" }
  ],
  "sample": {
    "brand": { "type": "text", "value": "Confirm the story before the slides" },
    "meta": { "type": "text", "value": "Weekly meeting pitch - 2026-09" },
    "title": { "type": "text", "value": "11 of 16 layout rounds were reorders" },
    "chart": {
      "type": "chart",
      "kind": "bar",
      "unit": " rounds",
      "toggle": true,
      "series": [
        { "label": "Content reorder", "value": 11 },
        { "label": "Type size, figures", "value": 3 },
        { "label": "Colour and fonts", "value": 2 }
      ]
    },
    "aside": { "type": "metric", "value": "69%", "label": "of layout fixes were order problems", "delta": "11 / 16 rounds" },
    "caption": { "type": "text", "value": "Last quarter: six decks, 24 revision rounds, logged one by one." },
    "page": { "type": "text", "value": "03 / 08" }
  }
}
